{
  "name": "disc",
  "version": "1.0.0",
  "description": "Deterministic Disciples-style strategy game",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc",
    "shot": "tsx scripts/shot.ts",
    "playtest": "tsx scripts/playtest.ts",
    "playtest:map": "tsx scripts/playtest.ts map",
    "check": "tsc && vitest run",
    "sim:bundle": "scripts/bundle-sims.sh",
    "sim": "scripts/bundle-sims.sh && node .sim/sim.mjs",
    "sim:world": "scripts/bundle-sims.sh && node .sim/sim-world.mjs",
    "sim:t1": "scripts/bundle-sims.sh && node .sim/sim-tier1.mjs",
    "sim:many": "scripts/bundle-sims.sh && node .sim/sim-many.mjs",
    "sim:comps": "scripts/bundle-sims.sh && node .sim/balance/compositions.mjs",
    "verify": "pnpm check && tsx scripts/shot.ts shots/verify.png \"/?fight&steps=6\" && tsx scripts/playtest.ts",
    "art": "tsx scripts/art/assets.ts",
    "audio": "tsx scripts/audio/report.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "imports": {
    "#rules/*": "./src/rules/*.ts",
    "#view/*": "./src/view/*.ts",
    "#tests/*": "./tests/*.ts",
    "#scripts/*": "./scripts/*.ts"
  }
}
