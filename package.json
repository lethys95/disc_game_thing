{
  "name": "disc",
  "version": "1.0.0",
  "description": "Deterministic Disciples-style strategy game",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc",
    "shot": "tsx scripts/shot.ts",
    "playtest": "tsx scripts/playtest.ts",
    "playtest:map": "tsx scripts/playtest-map.ts",
    "check": "tsc && vitest run",
    "sim": "tsx scripts/sim.ts",
    "sim:world": "tsx scripts/sim-world.ts",
    "verify": "pnpm check && tsx scripts/shot.ts shots/verify.png \"/?fight&steps=6\" && tsx scripts/playtest.ts && tsx scripts/playtest-map.ts 4 && tsx scripts/playtest-save.ts && tsx scripts/playtest-city.ts && tsx scripts/playtest-settings.ts && tsx scripts/playtest-setup.ts",
    "art": "tsx scripts/art/assets.ts",
    "playtest:save": "tsx scripts/playtest-save.ts",
    "playtest:city": "tsx scripts/playtest-city.ts",
    "playtest:settings": "tsx scripts/playtest-settings.ts",
    "playtest:setup": "tsx scripts/playtest-setup.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "imports": {
    "#rules/*": "./src/rules/*.ts",
    "#view/*": "./src/view/*.ts",
    "#tests/*": "./tests/*.ts",
    "#scripts/*": "./scripts/*.ts"
  }
}
